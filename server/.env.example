# =========================================================
# Adobe Sign (Acrobat Sign) OAuth credentials
# =========================================================
# Create an OAuth application at https://acrobat.adobe.com/
# (Account -> Adobe Sign API -> API Applications -> Create)
# Grant scopes: user_login:self, agreement_send:account, agreement_write:account, agreement_read:account
# Then generate a refresh token via the OAuth authorization flow (see README.md)

ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_REFRESH_TOKEN=

# Region-specific Adobe Sign API host. Common values:
#   https://api.na1.adobesign.com   (US)
#   https://api.na2.adobesign.com   (US)
#   https://api.na4.adobesign.com   (US - newer accounts)
#   https://api.eu1.adobesign.com   (EU)
#   https://api.jp1.adobesign.com   (Japan)
# When the token is first refreshed, the actual host is returned by Adobe and
# this value is overridden automatically. Leave the default if you're unsure.
ADOBE_API_BASE=https://api.na4.adobesign.com

# Local server port for the backend
PORT=3000

# Comma-separated list of origins allowed to call this backend
# Use "*" for development. For production, list your portal URL(s).
ALLOWED_ORIGINS=*
